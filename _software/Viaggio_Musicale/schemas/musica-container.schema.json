{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/musica-container.schema.json",
  "title": "Contenitore musicale geo-storico",
  "type": "object",
  "required": [
    "schema_version",
    "container_id",
    "area",
    "period",
    "tradition",
    "scales"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "container_id": {
      "type": "string",
      "minLength": 3
    },
    "record_status": {
      "type": "string"
    },
    "area": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "period": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "tradition": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "scales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scale"
      }
    },
    "documented_modulations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modulation"
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "required": [
        "document_id",
        "label",
        "path"
      ],
      "properties": {
        "document_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "scale": {
      "type": "object",
      "required": [
        "scale_id",
        "name",
        "center",
        "notes_12tet",
        "pitch_classes_12tet"
      ],
      "properties": {
        "scale_id": {
          "type": "string",
          "minLength": 2
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "center": {
          "type": "object",
          "required": [
            "label",
            "pitch_class",
            "type"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "pitch_class": {
              "type": "integer",
              "minimum": 0,
              "maximum": 11
            },
            "type": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "notes_12tet": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "pitch_classes_12tet": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11
          }
        },
        "approximation": {
          "type": "object",
          "additionalProperties": true
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/document"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "modulation": {
      "type": "object",
      "required": [
        "modulation_id",
        "source_scale_id",
        "target_scale_id",
        "technique",
        "status"
      ],
      "properties": {
        "modulation_id": {
          "type": "string"
        },
        "source_scale_id": {
          "type": "string"
        },
        "target_scale_id": {
          "type": "string"
        },
        "technique": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "sources": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}